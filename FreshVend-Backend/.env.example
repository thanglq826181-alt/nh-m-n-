# Copy to .env and replace the placeholder secrets before running Docker Compose.
POSTGRES_DB=freshvend_db
POSTGRES_USER=freshvend
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=24h
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For running the API directly on your computer instead of Docker Compose,
# point DATABASE_URL at your local PostgreSQL instance.
DATABASE_URL=postgresql://freshvend:replace-with-a-strong-local-database-password@localhost:5432/freshvend_db?schema=public

# Used only when running `npm run db:seed` to create the first admin account.
ADMIN_USERNAME=freshvend-admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=FreshVend Administrator
